# ==============================================================================
# Aegis CoreBank — Single-Container Cloud Production Reference Deployment
# ==============================================================================
# Stage 1: Build React 19 Frontend SPA
# ------------------------------------------------------------------------------
FROM node:22-alpine AS frontend-builder
WORKDIR /app
COPY online-banking-frontend/package*.json ./
RUN npm ci
COPY online-banking-frontend/ ./
RUN npm run build

# ------------------------------------------------------------------------------
# Stage 2: Build Maven Multi-Module Microservices
# ------------------------------------------------------------------------------
FROM maven:3.9-eclipse-temurin-21 AS backend-builder
WORKDIR /workspace
COPY online-banking-system/ .
RUN mvn -q -DskipTests package

# ------------------------------------------------------------------------------
# Stage 3: Runtime Container (Nginx + Temurin JRE 21)
# ------------------------------------------------------------------------------
FROM eclipse-temurin:21-jre-alpine
RUN apk add --no-cache nginx

# Copy Nginx configuration
COPY cloud/nginx.conf /etc/nginx/conf.d/default.conf

# Copy compiled frontend assets
COPY --from=frontend-builder /app/dist /usr/share/nginx/html

# Copy compiled backend JARs
WORKDIR /app
COPY --from=backend-builder /workspace/auth-service/target/auth-service.jar /app/auth-service.jar
COPY --from=backend-builder /workspace/account-service/target/account-service.jar /app/account-service.jar
COPY --from=backend-builder /workspace/transaction-service/target/transaction-service.jar /app/transaction-service.jar
COPY --from=backend-builder /workspace/notification-service/target/notification-service.jar /app/notification-service.jar

# Copy entrypoint
COPY cloud/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Expose HTTP port
EXPOSE 80 8080 7860

ENTRYPOINT ["/app/entrypoint.sh"]
