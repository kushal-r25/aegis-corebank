# ==============================================================================
# Aegis CoreBank — Production Environment Variables Template (.env.prod)
# ==============================================================================
# INSTRUCTIONS:
# Copy this file to `.env.prod` on your production server.
# NEVER commit the actual `.env.prod` with live secrets to Git.
# ==============================================================================

# Database Credentials
POSTGRES_USER=aegis_admin
POSTGRES_AUTH_PASSWORD=CHANGE_ME_SECURE_AUTH_DB_PASS_12345
POSTGRES_ACCOUNT_PASSWORD=CHANGE_ME_SECURE_ACCOUNT_DB_PASS_12345
POSTGRES_TXN_PASSWORD=CHANGE_ME_SECURE_TXN_DB_PASS_12345

# JWT Cryptographic Signing Secret (Minimum 256-bit / 32 bytes)
JWT_SECRET=CHANGE_ME_SUPER_STRONG_RANDOM_JWT_SECRET_STRING_64_CHARS_LONG_EXAMPLE

# Production Domain & SSL (for Let's Encrypt / Ingress)
DOMAIN_NAME=bank.example.com
SSL_EMAIL=security@example.com

# Spring Profile
SPRING_PROFILES_ACTIVE=production
